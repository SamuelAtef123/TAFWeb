# Copy this file to ".env" in the backend folder and fill in your own values.
# The real .env is ignored by git - never commit it.

# MongoDB connection string. Add a database name at the end (here: tino_friends).
MONGO_URI=mongodb://localhost:27017/tino_friends

# Long random string used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Password for the admin dashboard (/admin/login).
ADMIN_PASSWORD=change-me

PORT=5000
